[Unit]
Description=Kizuki Gauntlet observer health check
After=kizuki-gauntlet.service

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/home/ubuntu/LifeOS/operations/kizuki-gauntlet
ExecStart=/usr/bin/python3 /home/ubuntu/LifeOS/operations/kizuki-gauntlet/gauntlet.py --config /home/ubuntu/LifeOS/operations/kizuki-gauntlet/config.json --state-dir /home/ubuntu/.local/state/kizuki-gauntlet doctor
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8765/v1/health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
ReadWritePaths=/home/ubuntu/.local/state/kizuki-gauntlet
ReadOnlyPaths=/home/ubuntu/LifeOS/operations/kizuki-gauntlet
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
