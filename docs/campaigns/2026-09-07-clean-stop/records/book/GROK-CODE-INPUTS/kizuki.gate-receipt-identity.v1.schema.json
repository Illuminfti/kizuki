{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kizuki.gate-receipt-identity/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_source_sha",
    "producer",
    "producer_revision",
    "producer_files",
    "source_class",
    "actor_class",
    "attempt_id",
    "recorded_at"
  ],
  "properties": {
    "candidate_source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
      }
    },
    "source_class": {
      "enum": [
        "synthetic-fixture",
        "local-operator-custody",
        "native-host-attestation",
        "candidate-tree-inventory",
        "exact-candidate-ci-snapshot",
        "independent-reviewer",
        "findings-snapshot",
        "live-account-operator",
        "file-import-operator",
        "local-source-operator",
        "non-author-participant",
        "independent-witness",
        "supervised-owner-observation",
        "paired-estate-observation",
        "owner-operational-authority"
      ]
    },
    "actor_class": {
      "enum": [
        "automated-producer",
        "retained-ci-snapshot",
        "enrolled-reviewer",
        "authorized-operator",
        "independent-witness",
        "owner-or-delegated-maintainer"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
