{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kizuki.surface-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "outcome",
    "failures",
    "head_sha",
    "bun_version",
    "cli_verbs",
    "retired_verbs",
    "mcp_tools",
    "connectors_registered",
    "connectors_c3",
    "docs",
    "disagreements"
  ],
  "properties": {
    "schema": {
      "const": "kizuki.surface-inventory/v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_source_sha",
        "producer",
        "producer_revision",
        "producer_files",
        "source_class",
        "actor_class",
        "attempt_id",
        "recorded_at"
      ],
      "properties": {
        "candidate_source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$"
          }
        },
        "source_class": {
          "enum": [
            "synthetic-fixture",
            "local-operator-custody",
            "native-host-attestation",
            "candidate-tree-inventory",
            "exact-candidate-ci-snapshot",
            "independent-reviewer",
            "findings-snapshot",
            "live-account-operator",
            "file-import-operator",
            "local-source-operator",
            "non-author-participant",
            "independent-witness",
            "supervised-owner-observation",
            "paired-estate-observation",
            "owner-operational-authority"
          ]
        },
        "actor_class": {
          "enum": [
            "automated-producer",
            "retained-ci-snapshot",
            "enrolled-reviewer",
            "authorized-operator",
            "independent-witness",
            "owner-or-delegated-maintainer"
          ]
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "unresolved"
      ]
    },
    "failures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "bun_version": {
      "const": "1.3.14"
    },
    "cli_verbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retired_verbs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mcp_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors_registered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors_c3": {
      "type": "array"
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
