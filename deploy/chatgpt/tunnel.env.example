# Operator-owned systemd EnvironmentFile. Replace every example value.
# Keep the real file outside the checkout with mode 0600 in a 0700 directory.
# Values containing spaces must be quoted using systemd EnvironmentFile syntax.
TUNNEL_CLIENT_BIN=/opt/tunnel-client/tunnel-client
KIZUKI_MCP_BIN=/opt/kizuki-package/kizuki-mcp
KIZUKI_VAULT=/absolute/vault
KIZUKI_AGENT_CREDENTIAL=/absolute/private/chatgpt.credential
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_REGISTERED_ID
# Fill through the operator's secure secret flow, never chat or shell history.
CONTROL_PLANE_API_KEY=REPLACE_WITH_RUNTIME_KEY
