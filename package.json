{
  "name": "kizuki-workspace",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": { "bun": "1.3.10" },
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "build:release": "bun scripts/build-release.ts",
    "smoke:release": "bun scripts/smoke-release.ts",
    "proof:artifact": "bun scripts/stranger-proof.ts",
    "proof:recovery": "bun scripts/recovery-artifact-proof.ts",
    "release:acceptance": "bun scripts/go-no-go.ts",
    "verify:network": "bun scripts/verify-network.ts",
    "ci:workflows": "bun scripts/verify-workflows.ts",
    "ci:secrets": "bun scripts/verify-secrets.ts",
    "ci:gitleaks": "bash scripts/ci-gitleaks.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/bun": "1.3.10"
  }
}
